{
  "name": "water-sort-level-generator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "node --import tsx src/cli/generate.ts",
    "validate": "node --import tsx src/cli/validate.ts",
    "export:runtime": "node --import tsx src/cli/export-runtime.ts",
    "export:solutions": "node --import tsx src/cli/export-solutions.ts",
    "benchmark": "node --import tsx src/cli/benchmark.ts",
    "analyze:difficulty": "node --import tsx src/cli/analyze-difficulty.ts",
    "merge": "node --import tsx src/cli/merge.ts",
    "certify": "node --import tsx src/cli/certify.ts",
    "compare:shards": "node --import tsx src/cli/compare-shards.ts",
    "analyze:shard": "node --import tsx src/cli/analyze-shard.ts",
    "recover:artifact": "node --import tsx src/cli/recover-artifact.ts",
    "report:coverage": "node --import tsx src/cli/report-coverage.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0"
}
